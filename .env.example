# ─── Lia v3 environment ─────────────────────────────────────────────
# Copy to .env and adjust. All values are optional for M0.

# Runtime
LIA_RUNTIME=node            # node | bun
LIA_LOG_LEVEL=info          # trace | debug | info | warn | error

# Backend
LIA_BACKEND_HOST=127.0.0.1
LIA_BACKEND_PORT=8787

# Database
LIA_DB_PATH=./data/lia.db

# Ollama (used from M1 onward)
OLLAMA_HOST=http://127.0.0.1:11434

# Agent security
# LIA_WORKSPACE_ROOT=/path/to/allowed/root   # if unset, fsScope must be under episode mounts
# LIA_ALLOW_SHELL=0                         # set to 1 to enable agent run_command
# LIA_AUTO_APPLY_FILES=0                    # set to 1 to write agent file edits immediately (skip Apply UI)
# LIA_ALLOW_DEPLOY=0                        # set to 1 to enable deploy presets from .lia/deploy.json
# LIA_ALLOW_SSH=0                           # set to 1 to enable ssh_run on allowlisted hosts
# LIA_SSH_ALLOWLIST=user@prod.example.com,staging.example.com

# Frontend (Vite dev server)
VITE_BACKEND_URL=http://127.0.0.1:8787
