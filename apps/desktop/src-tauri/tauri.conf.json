{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lia",
  "version": "0.1.0",
  "identifier": "ai.lia.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev --workspace @lia/desktop",
    "beforeBuildCommand": "npm run build --workspace @lia/desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Lia v3",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "Productivity",
    "shortDescription": "Lia — personal AI companion",
    "longDescription": "Local-first AI companion with model-driven agent orchestration and unified EpisodeWorkspace API."
  }
}
